#!/usr/bin/env bash
set -euo pipefail

# Run from repo root (in case git runs hook from elsewhere)
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ---- Helpers ---------------------------------------------------------------

sync_path() {
  local src="$1"
  local dst="$2"
  shift 2
  local -a excludes=("$@")

  if [[ -d "$src" ]]; then
    mkdir -p "$dst"

    local -a rsync_args=(-a --delete)
    for ex in "${excludes[@]}"; do
      rsync_args+=(--exclude "$ex")
    done

    rsync "${rsync_args[@]}" "$src/" "$dst/"
    git add "$dst"
    echo "pre-commit: synced dir  $src -> $dst"
    return 0
  fi

  if [[ -f "$src" ]]; then
    mkdir -p "$(dirname "$dst")"
    # For files, use rsync without trailing slash
    rsync -a "$src" "$dst"
    git add "$dst"
    echo "pre-commit: synced file $src -> $dst"
    return 0
  fi

  echo "pre-commit: WARN missing source, skipping: $src"
  return 0
}

# ---- Config: source -> destination mappings -------------------------------

# Convention:
# - Store system files under a namespaced folder in your repo, e.g.:
#   .system/etc/...
#   .system/boot/...
#
# This avoids collisions with your repo's actual .config, etc.

# DankMaterialShell excludes (submodules + cache)
DMS_EXCLUDES=(
  'plugins/.repos/'
  'plugins/calculator/'
  'plugins/dmsSessionizer/'
  'plugins/emojiLauncher/'
  'plugins/mediaPlayer/'
  'plugins/niriWindows/'
  'plugins/powerOptions/'
  'plugins/webSearch/'
)

# 1) DankMaterialShell (directory)
sync_path \
  "/home/kevin/.config/DankMaterialShell" \
  ".config/DankMaterialShell" \
  "${DMS_EXCLUDES[@]}"

# 2) mkinitcpio config (file)  [typo fixed from mkinitpcio]
sync_path \
  "/etc/mkinitcpio.conf" \
  "./etc/mkinitcpio.conf"

# 3) grub defaults (recommended to track instead of generated grub.cfg)
sync_path \
  "/etc/default/grub" \
  "./etc/default/grub"

# 4) Plymouth configs
sync_path \
  "/etc/plymouth/plymouthd.conf" \
  "./etc/plymouth/plymouthd.conf"

echo "pre-commit: all sync tasks completed"
